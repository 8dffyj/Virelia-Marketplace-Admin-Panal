<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Virelia - Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      background: linear-gradient(135deg, #1a1f3a 0%, #2d3561 50%, #1f2847 100%);
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #e8f0f2;
    }
    
    .navbar {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      box-shadow: 0 4px 20px rgba(79, 172, 254, 0.3);
      padding: 1rem 0;
    }
    
    .navbar-brand {
      font-weight: 700;
      font-size: 1.8rem;
      color: white !important;
      text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    }
    
    .stat-card {
      background: linear-gradient(135deg, #2a3f5f 0%, #1e2d42 100%);
      border-radius: 20px;
      padding: 2rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(79, 172, 254, 0.1);
      position: relative;
      overflow: hidden;
      transition: all 0.4s ease;
    }
    
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #4facfe 0%, #00f2fe 50%, #a8edea 100%);
    }
    
    .stat-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 40px rgba(79, 172, 254, 0.25);
      border-color: rgba(79, 172, 254, 0.3);
    }
    
    .stat-card h5 {
      color: #a0b8c8;
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 500;
    }
    
    .stat-card .number {
      font-size: 3rem;
      font-weight: 700;
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 50%, #a8edea 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .stat-card .icon {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 3rem;
      opacity: 0.08;
      color: #4facfe;
    }
    
    .user-card {
      background: linear-gradient(135deg, #2a3f5f 0%, #1e2d42 100%);
      border-radius: 20px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(79, 172, 254, 0.1);
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }
    
    .user-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      transition: all 0.4s ease;
    }
    
    .user-card.db-user::before {
      background: linear-gradient(180deg, #43e97b 0%, #38f9d7 100%);
      box-shadow: 0 0 15px rgba(67, 233, 123, 0.4);
    }
    
    .user-card.server-user::before {
      background: linear-gradient(180deg, #4facfe 0%, #00f2fe 100%);
      box-shadow: 0 0 15px rgba(79, 172, 254, 0.4);
    }
    
    .user-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 40px rgba(79, 172, 254, 0.2);
      border-color: rgba(79, 172, 254, 0.3);
    }
    
    .user-card h6 {
      color: #ffffff;
      font-weight: 600;
      font-size: 1.1rem;
    }
    
    .user-card p {
      color: #a0b8c8;
    }
    
    .user-avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 0.5rem;
      border: 3px solid rgba(79, 172, 254, 0.4);
      box-shadow: 0 4px 15px rgba(79, 172, 254, 0.2);
      transition: all 0.4s ease;
    }
    
    .user-card:hover .user-avatar {
      transform: scale(1.08);
      border-color: rgba(79, 172, 254, 0.7);
      box-shadow: 0 6px 20px rgba(79, 172, 254, 0.4);
    }
    
    .badge-online {
      background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
      animation: gentlePulse 3s infinite ease-in-out;
      box-shadow: 0 0 15px rgba(67, 233, 123, 0.4);
    }
    
    @keyframes gentlePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(0.98); }
    }
    
    .badge {
      padding: 0.4rem 0.8rem;
      border-radius: 20px;
      font-weight: 600;
      font-size: 0.75rem;
    }
    
    .bg-secondary {
      background: linear-gradient(135deg, #6c7a89 0%, #525d6e 100%) !important;
    }
    
    .bg-success {
      background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%) !important;
    }
    
    .filter-btn {
      border-radius: 25px;
      padding: 0.7rem 1.8rem;
      font-weight: 600;
      transition: all 0.3s ease;
      border: 2px solid rgba(79, 172, 254, 0.2);
      color: #a0b8c8;
      background: rgba(42, 63, 95, 0.4);
      margin-right: 0.5rem;
      margin-bottom: 0.5rem;
    }
    
    .filter-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(79, 172, 254, 0.5);
      color: #ffffff;
      background: rgba(42, 63, 95, 0.6);
    }
    
    .filter-btn.active {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      color: white;
      border-color: transparent;
      box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
    }
    
    .search-box {
      border-radius: 25px;
      padding: 0.9rem 1.8rem;
      border: 2px solid rgba(79, 172, 254, 0.2);
      transition: all 0.3s ease;
      background: rgba(42, 63, 95, 0.4);
      color: #ffffff;
      font-size: 1rem;
    }
    
    .search-box::placeholder {
      color: #6c7a89;
    }
    
    .search-box:focus {
      border-color: #4facfe;
      box-shadow: 0 0 0 4px rgba(79, 172, 254, 0.15);
      background: rgba(42, 63, 95, 0.6);
      outline: none;
    }
    
    .btn-sync, .btn-light {
      background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
      border: none;
      color: #2a3f5f !important;
      font-weight: 600;
      border-radius: 12px;
      padding: 0.7rem 1.5rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(168, 237, 234, 0.3);
    }
    
    .btn-sync:hover, .btn-light:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(168, 237, 234, 0.4);
      color: #2a3f5f !important;
    }
    
    .btn-outline-light {
      border: 2px solid rgba(255, 255, 255, 0.3);
      color: white !important;
      border-radius: 12px;
      padding: 0.7rem 1.5rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    
    .btn-outline-light:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: white;
      transform: translateY(-2px);
    }
    
    .btn-primary {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      border: none;
      border-radius: 10px;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
    }
    
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(79, 172, 254, 0.4);
    }
    
    .btn-danger {
      background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
      border: none;
      border-radius: 10px;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(250, 112, 154, 0.3);
    }
    
    .btn-danger:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(250, 112, 154, 0.4);
    }
    
    .role-badge {
      font-size: 0.7rem;
      padding: 0.3rem 0.8rem;
      margin-right: 0.3rem;
      margin-bottom: 0.3rem;
      background: rgba(79, 172, 254, 0.15);
      border: 1px solid rgba(79, 172, 254, 0.3);
      border-radius: 15px;
      color: #a0b8c8;
    }
    
    .text-white {
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    
    .container-fluid {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    
    @media (max-width: 768px) {
      .stat-card .number {
        font-size: 2rem;
      }
      
      .filter-btn {
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark">
    <div class="container-fluid">
      <span class="navbar-brand"><i class="fas fa-users-cog"></i> Virelia</span>
      <div>
        <% if (isAdmin) { %>
          <button class="btn btn-light btn-sm me-2" onclick="syncServer()">
            <i class="fas fa-sync"></i> Sync Server
          </button>
          <a href="/logs" class="btn btn-light btn-sm me-2">
            <i class="fas fa-list"></i> Logs
          </a>
        <% } %>
        <span class="text-white me-3"><%= user.username %></span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid mt-4">
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="stat-card">
          <i class="fas fa-users icon"></i>
          <h5>Total Users</h5>
          <div class="number"><%= stats.total %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card">
          <i class="fas fa-database icon"></i>
          <h5>Database Users</h5>
          <div class="number"><%= stats.db_users %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card">
          <i class="fas fa-server icon"></i>
          <h5>Server Members</h5>
          <div class="number"><%= stats.server_only %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card">
          <i class="fas fa-circle icon"></i>
          <h5>Online</h5>
          <div class="number"><%= stats.online %></div>
        </div>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-12">
        <input type="text" id="searchBox" class="search-box w-100" placeholder="🔍 Search by username, ID, or email...">
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-12">
        <button class="filter-btn active" onclick="filterUsers('all')">All Users</button>
        <button class="filter-btn" onclick="filterUsers('db')">DB Users</button>
        <button class="filter-btn" onclick="filterUsers('server')">Server Only</button>
        <button class="filter-btn" onclick="filterUsers('online')">Online</button>
      </div>
    </div>

    <div class="row" id="usersContainer">
      <% allUsers.forEach(u => { %>
        <div class="col-md-6 col-lg-4 user-item" data-filter="<%= u.in_server && !u.created_at ? 'server' : 'db' %>" data-username="<%= u.username.toLowerCase() %>" data-id="<%= u._id %>">
          <div class="user-card <%= u.in_server && !u.created_at ? 'server-user' : 'db-user' %>">
            <div class="text-center">
              <img src="<%= u.avatar ? `https://cdn.discordapp.com/avatars/${u._id}/${u.avatar}.png` : 'https://via.placeholder.com/70' %>" alt="<%= u.username %>" class="user-avatar">
              <span class="badge <%= u.last_login && (Date.now() - new Date(u.last_login)) < 30 * 60 * 1000 ? 'badge-online' : 'bg-secondary' %>">
                <%= u.last_login && (Date.now() - new Date(u.last_login)) < 30 * 60 * 1000 ? 'Online' : 'Offline' %>
              </span>
            </div>
            <h6 class="mt-2"><%= u.username %></h6>
            <p style="font-size: 0.85rem;">ID: <%= u._id %></p>
            <% if (u.email) { %>
              <p style="font-size: 0.85rem;">Email: <%= u.email %></p>
            <% } %>
            <p style="font-size: 0.85rem;">
              <i class="fas fa-coins"></i> VV Balance: <strong><%= u.vv_balance %></strong>
              <% if (u.vv_balance > 0) { %>
                <span class="badge bg-success ms-2">Has Balance</span>
              <% } else { %>
                <span class="badge bg-secondary ms-2">No Balance</span>
              <% } %>
            </p>
            <% if (u.server_roles && u.server_roles.length > 0) { %>
              <p style="font-size: 0.8rem;">Roles: <%= u.server_roles.length %></p>
            <% } %>
            <% if (isAdmin) { %>
              <div class="d-grid gap-2">
                <a href="/edit/<%= u._id %>" class="btn btn-sm btn-primary mt-2">
                  <i class="fas fa-edit"></i> Edit
                </a>
                <button class="btn btn-sm btn-danger" onclick="deleteUser('<%= u._id %>', '<%= u.username %>')">
                  <i class="fas fa-trash"></i> Remove from DB
                </button>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <script>
    let currentFilter = 'all';

    function filterUsers(type) {
      currentFilter = type;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');

      document.querySelectorAll('.user-item').forEach(item => {
        let show = false;
        if (type === 'all') show = true;
        else if (type === 'db') show = item.dataset.filter === 'db';
        else if (type === 'server') show = item.dataset.filter === 'server';
        else if (type === 'online') show = item.querySelector('.badge-online') !== null;

        item.style.display = show ? 'block' : 'none';
      });
    }

    document.getElementById('searchBox').addEventListener('input', (e) => {
      const search = e.target.value.toLowerCase();
      document.querySelectorAll('.user-item').forEach(item => {
        const username = item.dataset.username;
        const id = item.dataset.id;
        const visible = username.includes(search) || id.includes(search);
        item.style.display = visible ? 'block' : 'none';
      });
    });

    function syncServer() {
      if (!confirm('Sync server data? This may take a moment.')) return;
      fetch('/sync-server', { method: 'POST' })
        .then(r => r.json())
        .then(d => {
          alert(`Sync complete!\nNew: ${d.new_members}\nUpdated: ${d.updated_members}\nTotal: ${d.total_members}`);
          location.reload();
        })
        .catch(e => alert('Sync failed: ' + e.message));
    }

    function deleteUser(userId, username) {
      if (!confirm(`Are you sure you want to remove ${username} from the database?\n\nThis action cannot be undone!`)) return;
      
      fetch(`/delete/${userId}`, { method: 'DELETE' })
        .then(r => r.json())
        .then(d => {
          if (d.success) {
            alert(`✅ ${d.message}`);
            location.reload();
          } else {
            alert(`❌ Error: ${d.error}`);
          }
        })
        .catch(e => alert('Delete failed: ' + e.message));
    }

    setInterval(() => location.reload(), 5 * 60 * 1000);
  </script>
</body>
</html>