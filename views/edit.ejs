<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User - Virelia</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #1a1f3a 0%, #2d3561 50%, #1f2847 100%);
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #e8f0f2;
    }
    
    .navbar {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      box-shadow: 0 4px 20px rgba(79, 172, 254, 0.3);
      padding: 1rem 0;
    }
    
    .navbar-brand {
      font-weight: 700;
      font-size: 1.5rem;
      color: white !important;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    
    .navbar-brand:hover {
      transform: translateX(-5px);
    }
    
    .edit-container {
      background: linear-gradient(135deg, #2a3f5f 0%, #1e2d42 100%);
      border-radius: 25px;
      padding: 3rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      max-width: 700px;
      margin: 2rem auto;
      border: 1px solid rgba(79, 172, 254, 0.2);
    }
    
    .form-label {
      font-weight: 600;
      color: #a0b8c8;
      margin-bottom: 0.7rem;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
    }
    
    .form-control {
      border-radius: 15px;
      border: 2px solid rgba(79, 172, 254, 0.2);
      padding: 0.9rem 1.2rem;
      transition: all 0.3s ease;
      background: rgba(42, 63, 95, 0.3);
      color: #ffffff;
      font-size: 1rem;
    }
    
    .form-control::placeholder {
      color: #6c7a89;
    }
    
    .form-control:focus {
      border-color: #4facfe;
      box-shadow: 0 0 0 4px rgba(79, 172, 254, 0.15);
      background: rgba(42, 63, 95, 0.5);
      outline: none;
      color: #ffffff;
    }
    
    .input-group-text {
      background: rgba(79, 172, 254, 0.15);
      border: 2px solid rgba(79, 172, 254, 0.2);
      border-right: none;
      color: #4facfe;
      font-weight: 600;
      border-radius: 15px 0 0 15px;
    }
    
    .input-group .form-control {
      border-left: none;
      border-radius: 0 15px 15px 0;
    }
    
    .btn-save {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      border: none;
      color: white;
      font-weight: 700;
      border-radius: 15px;
      padding: 1rem 2rem;
      width: 100%;
      margin-top: 1.5rem;
      font-size: 1.1rem;
      transition: all 0.3s ease;
      box-shadow: 0 8px 25px rgba(79, 172, 254, 0.3);
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    .btn-save:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(79, 172, 254, 0.4);
      color: white;
    }
    
    .user-header {
      display: flex;
      align-items: center;
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid rgba(79, 172, 254, 0.2);
      position: relative;
    }
    
    .user-header::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100px;
      height: 2px;
      background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
    }
    
    .user-avatar-large {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 2rem;
      border: 4px solid rgba(79, 172, 254, 0.4);
      box-shadow: 0 8px 30px rgba(79, 172, 254, 0.3);
      transition: all 0.4s ease;
    }
    
    .user-avatar-large:hover {
      transform: scale(1.05) rotate(3deg);
      border-color: rgba(79, 172, 254, 0.7);
    }
    
    .user-info h3 {
      margin: 0;
      color: #ffffff;
      font-weight: 700;
      font-size: 1.8rem;
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 50%, #a8edea 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .user-info p {
      margin: 0.5rem 0;
      color: #a0b8c8;
      font-size: 0.95rem;
    }
    
    .alert {
      border-radius: 15px;
      border: none;
      padding: 1.2rem;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    
    .alert-success {
      background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
      color: white;
    }
    
    .alert-danger {
      background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
      color: white;
    }
    
    .mb-3 {
      margin-bottom: 1.5rem !important;
    }
    
    @media (max-width: 768px) {
      .edit-container {
        padding: 2rem 1.5rem;
        margin: 1rem;
      }
      
      .user-header {
        flex-direction: column;
        text-align: center;
      }
      
      .user-avatar-large {
        margin-right: 0;
        margin-bottom: 1rem;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark">
    <div class="container-fluid">
      <a href="/dashboard" class="navbar-brand"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    </div>
  </nav>

  <div class="container">
    <div class="edit-container">
      <div class="user-header">
        <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user._id}/${user.avatar}.png` : 'https://via.placeholder.com/100' %>" alt="<%= user.username %>" class="user-avatar-large">
        <div class="user-info">
          <h3><%= user.username %></h3>
          <p><i class="fas fa-id-card"></i> ID: <%= user._id %></p>
          <p><i class="fas fa-calendar-alt"></i> Joined: <%= new Date(user.created_at).toLocaleDateString() %></p>
        </div>
      </div>

      <div id="alertBox"></div>

      <form id="editForm">
        <div class="mb-3">
          <label for="username" class="form-label"><i class="fas fa-user"></i> Username</label>
          <input type="text" class="form-control" id="username" name="username" value="<%= user.username %>" required>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label"><i class="fas fa-envelope"></i> Email</label>
          <input type="email" class="form-control" id="email" name="email" value="<%= user.email || '' %>" placeholder="user@example.com">
        </div>

        <div class="mb-3">
          <label for="vv_balance" class="form-label"><i class="fas fa-coins"></i> VV Balance</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-coins"></i></span>
            <input type="number" class="form-control" id="vv_balance" name="vv_balance" value="<%= user.vv_balance %>" min="0" required>
          </div>
        </div>

        <button type="submit" class="btn btn-save">
          <i class="fas fa-save"></i> Save Changes
        </button>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/edit/<%= user._id %>', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();
        const alertBox = document.getElementById('alertBox');

        if (result.success) {
          alertBox.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle"></i> User updated successfully!</div>';
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1500);
        } else {
          alertBox.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> Error: ${result.error}</div>`;
        }
      } catch (error) {
        document.getElementById('alertBox').innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> Error: ${error.message}</div>`;
      }
    });
  </script>
</body>
</html>