<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
        }
        .edit-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .user-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>
<body class="text-light">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: rgba(0, 0, 0, 0.3);">
        <div class="container">
            <a class="navbar-brand" href="/dashboard">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card edit-card text-light">
                    <div class="card-header">
                        <h4><i class="fas fa-user-edit"></i> Edit User</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-3 text-center">
                                <% if (editUser.avatar) { %>
                                    <img src="https://cdn.discordapp.com/avatars/<%= editUser._id %>/<%= editUser.avatar %>.png" 
                                         class="user-avatar" alt="Avatar">
                                <% } else { %>
                                    <div class="user-avatar bg-secondary d-flex align-items-center justify-content-center mx-auto">
                                        <i class="fas fa-user fa-2x"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="col-md-9">
                                <h5><%= editUser.username %></h5>
                                <p class="text-muted">Discord ID: <%= editUser._id %></p>
                                <p class="text-muted">Member since: <%= new Date(editUser.created_at).toLocaleDateString() %></p>
                            </div>
                        </div>

                        <form action="/edit/<%= editUser._id %>" method="POST">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="username" class="form-label">Username</label>
                                        <input type="text" class="form-control" id="username" name="username" 
                                               value="<%= editUser.username %>" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" name="email" 
                                               value="<%= editUser.email || '' %>">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="vv_balance" class="form-label">
                                            <i class="fas fa-coins"></i> VV Balance
                                        </label>
                                        <div class="input-group">
                                            <input type="number" class="form-control" id="vv_balance" name="vv_balance" 
                                                   value="<%= editUser.vv_balance %>" step="0.01" min="0">
                                            <span class="input-group-text">VV</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Discord ID (Read-only)</label>
                                        <input type="text" class="form-control" value="<%= editUser._id %>" readonly>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Created At</label>
                                        <input type="text" class="form-control" 
                                               value="<%= new Date(editUser.created_at).toLocaleString() %>" readonly>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Last Updated</label>
                                        <input type="text" class="form-control" 
                                               value="<%= editUser.updated_at ? new Date(editUser.updated_at).toLocaleString() : 'Never' %>" readonly>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save"></i> Save Changes
                                </button>
                                <a href="/dashboard" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>