<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Webhook Logs - Virelia</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #1a1f3a 0%, #2d3561 50%, #1f2847 100%);
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #e8f0f2;
    }
    
    .navbar {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      box-shadow: 0 4px 20px rgba(79, 172, 254, 0.3);
      padding: 1rem 0;
    }
    
    .navbar-brand {
      font-weight: 700;
      font-size: 1.5rem;
      color: white !important;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    
    .navbar-brand:hover {
      transform: translateX(-5px);
    }
    
    .btn-light {
      background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
      border: none;
      color: #2a3f5f !important;
      font-weight: 600;
      border-radius: 12px;
      padding: 0.7rem 1.5rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(168, 237, 234, 0.3);
    }
    
    .btn-light:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(168, 237, 234, 0.4);
      color: #2a3f5f !important;
    }
    
    .log-container {
      background: linear-gradient(135deg, #2a3f5f 0%, #1e2d42 100%);
      border-radius: 25px;
      padding: 2.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      margin: 2rem 0;
      border: 1px solid rgba(79, 172, 254, 0.2);
    }
    
    .log-container h2 {
      color: #ffffff;
      font-weight: 700;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 50%, #a8edea 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .log-entry {
      border-left: 4px solid;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      border-radius: 15px;
      background: rgba(42, 63, 95, 0.4);
      transition: all 0.4s ease;
      border: 1px solid rgba(79, 172, 254, 0.1);
      position: relative;
      overflow: hidden;
    }
    
    .log-entry::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      transition: all 0.4s ease;
    }
    
    .log-entry:hover {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      transform: translateX(8px);
      background: rgba(42, 63, 95, 0.6);
    }
    
    .log-entry.success::before {
      background: linear-gradient(180deg, #43e97b 0%, #38f9d7 100%);
      box-shadow: 0 0 15px rgba(67, 233, 123, 0.4);
    }
    
    .log-entry.success {
      border-left-color: #43e97b;
      background: linear-gradient(135deg, rgba(67, 233, 123, 0.05) 0%, rgba(42, 63, 95, 0.4) 100%);
    }
    
    .log-entry.error::before {
      background: linear-gradient(180deg, #fa709a 0%, #fee140 100%);
      box-shadow: 0 0 15px rgba(250, 112, 154, 0.4);
    }
    
    .log-entry.error {
      border-left-color: #fa709a;
      background: linear-gradient(135deg, rgba(250, 112, 154, 0.05) 0%, rgba(42, 63, 95, 0.4) 100%);
    }
    
    .log-entry.info::before {
      background: linear-gradient(180deg, #4facfe 0%, #00f2fe 100%);
      box-shadow: 0 0 15px rgba(79, 172, 254, 0.4);
    }
    
    .log-entry.info {
      border-left-color: #4facfe;
      background: linear-gradient(135deg, rgba(79, 172, 254, 0.05) 0%, rgba(42, 63, 95, 0.4) 100%);
    }
    
    .log-entry.warning::before {
      background: linear-gradient(180deg, #feca57 0%, #ff9ff3 100%);
      box-shadow: 0 0 15px rgba(254, 202, 87, 0.4);
    }
    
    .log-entry.warning {
      border-left-color: #feca57;
      background: linear-gradient(135deg, rgba(254, 202, 87, 0.05) 0%, rgba(42, 63, 95, 0.4) 100%);
    }
    
    .log-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .log-title {
      font-weight: 700;
      color: #ffffff;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .log-title i {
      font-size: 1.3rem;
    }
    
    .log-action {
      font-size: 0.95rem;
      color: #a0b8c8;
      margin-top: 0.5rem;
    }
    
    .log-time {
      font-size: 0.85rem;
      color: #6c7a89;
      font-weight: 600;
    }
    
    .log-status {
      font-size: 0.8rem;
      padding: 0.4rem 1rem;
      border-radius: 20px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.5rem;
      display: inline-block;
    }
    
    .log-status.sent {
      background: linear-gradient(135deg, rgba(67, 233, 123, 0.2) 0%, rgba(56, 249, 215, 0.2) 100%);
      color: #43e97b;
      border: 1px solid rgba(67, 233, 123, 0.4);
      box-shadow: 0 0 15px rgba(67, 233, 123, 0.15);
    }
    
    .log-status.failed {
      background: linear-gradient(135deg, rgba(250, 112, 154, 0.2) 0%, rgba(254, 225, 64, 0.2) 100%);
      color: #fa709a;
      border: 1px solid rgba(250, 112, 154, 0.4);
      box-shadow: 0 0 15px rgba(250, 112, 154, 0.15);
    }
    
    .log-user-info, .log-error-info {
      font-size: 0.9rem;
      color: #a0b8c8;
      margin: 0.75rem 0 0 0;
      padding: 0.75rem;
      background: rgba(0, 0, 0, 0.15);
      border-radius: 10px;
      border-left: 3px solid #4facfe;
    }
    
    .log-error-info {
      border-left-color: #fa709a;
      color: #fa709a;
    }
    
    .log-user-info strong, .log-error-info strong {
      color: #ffffff;
      font-weight: 700;
    }
    
    .alert {
      border-radius: 15px;
      border: none;
      padding: 1.5rem;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(42, 63, 95, 0.5) 100%);
      color: #4facfe;
      border-left: 4px solid #4facfe;
    }
    
    .btn-retry {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      border: none;
      color: white;
      font-weight: 600;
      border-radius: 12px;
      padding: 0.7rem 1.8rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
    }
    
    .btn-retry:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(79, 172, 254, 0.4);
      color: white;
    }
    
    @media (max-width: 768px) {
      .log-container {
        padding: 1.5rem;
      }
      
      .log-header {
        flex-direction: column;
        align-items: flex-start;
      }
      
      .log-entry {
        padding: 1rem;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark">
    <div class="container-fluid">
      <a href="/dashboard" class="navbar-brand"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
      <button class="btn btn-light btn-sm" onclick="retryWebhooks()">
        <i class="fas fa-redo"></i> Retry Failed Webhooks
      </button>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="log-container">
      <h2><i class="fas fa-list"></i> Webhook Logs</h2>

      <% if (logs.length === 0) { %>
        <div class="alert">
          <i class="fas fa-info-circle"></i> No logs yet. Events will appear here.
        </div>
      <% } else { %>
        <% logs.forEach(log => { %>
          <div class="log-entry <%= log.webhook_sent ? 'success' : 'error' %>">
            <div class="log-header">
              <div>
                <div class="log-title">
                  <i class="fas <%= log.webhook_sent ? 'fa-check-circle' : 'fa-exclamation-circle' %>"></i>
                  <%= log.event_type %>
                </div>
                <div class="log-action">
                  <%= log.action %>
                </div>
              </div>
              <div class="text-end">
                <span class="log-status <%= log.webhook_sent ? 'sent' : 'failed' %>">
                  <%= log.webhook_sent ? 'Sent' : 'Failed' %>
                </span>
                <div class="log-time">
                  <i class="fas fa-clock"></i> <%= new Date(log.created_at).toLocaleString() %>
                </div>
              </div>
            </div>
            <% if (log.user_id) { %>
              <p class="log-user-info">
                <strong>User:</strong> <%= log.user_id %>
              </p>
            <% } %>
            <% if (!log.webhook_sent && log.error) { %>
              <p class="log-error-info">
                <strong>Error:</strong> <%= log.error %> <span style="color: #a0b8c8;">(Retry: <%= log.retry_count %>/5)</span>
              </p>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <script>
    function retryWebhooks() {
      if (!confirm('Retry all failed webhook deliveries?')) return;
      fetch('/retry-webhooks', { method: 'POST' })
        .then(r => r.json())
        .then(d => {
          alert(`Retry initiated for ${d.retried} failed webhooks`);
          setTimeout(() => location.reload(), 1000);
        })
        .catch(e => alert('Error: ' + e.message));
    }
  </script>
</body>
</html>