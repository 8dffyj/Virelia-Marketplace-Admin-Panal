<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Virelia - Discord User Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .login-container {
      background: rgba(255, 255, 255, 0.95);
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      text-align: center;
      max-width: 400px;
    }
    .logo {
      font-size: 3rem;
      margin-bottom: 1rem;
      color: #667eea;
    }
    h1 {
      color: #333;
      margin-bottom: 0.5rem;
      font-weight: 700;
    }
    .subtitle {
      color: #666;
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }
    .btn-discord {
      background: #5865F2;
      border: none;
      padding: 0.75rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      transition: all 0.3s;
    }
    .btn-discord:hover {
      background: #4752C4;
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(88, 101, 242, 0.3);
    }
    .btn-discord {
      color: white !important;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="login-container mx-auto">
      <div class="logo">
        <i class="fas fa-users-cog"></i>
      </div>
      <h1>Virelia</h1>
      <p class="subtitle">Discord User Management System</p>
      <p style="color: #666; margin-bottom: 2rem; font-size: 0.9rem;">Login with Discord to access the dashboard</p>
      <a href="/auth/discord" class="btn btn-discord w-100">
        <i class="fab fa-discord"></i> Login with Discord
      </a>
      <p style="color: #999; font-size: 0.85rem; margin-top: 2rem;">Ar734 • Secure • Open Source</p>
    </div>
  </div>
</body>
</html>