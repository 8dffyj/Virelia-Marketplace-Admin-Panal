<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord User Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <h1 class="mb-4">
                    <i class="fab fa-discord text-primary"></i>
                    User Management Dashboard
                </h1>
                
                <% if (!user) { %>
                    <div class="card bg-secondary">
                        <div class="card-body">
                            <h5 class="card-title">Welcome!</h5>
                            <p class="card-text">Please login with Discord to access the dashboard.</p>
                            <a href="/auth/discord" class="btn btn-primary btn-lg">
                                <i class="fab fa-discord"></i> Login with Discord
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="card bg-secondary">
                        <div class="card-body">
                            <h5 class="card-title">Welcome back, <%= user.username %>!</h5>
                            <p class="card-text">You are successfully logged in.</p>
                            <a href="/dashboard" class="btn btn-success btn-lg me-2">
                                <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                            </a>
                            <a href="/logout" class="btn btn-outline-light">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>