# File: .env.example

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Discord Bot Configuration (for role checking)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
REQUIRED_ROLE_ID=your_required_role_id

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string

# Session Configuration
SESSION_SECRET=your_session_secret_key

# Server Configuration
PORT=3000

# Webhook logging configuration
WEBHOOK_URL=your_discord_webhook_url

# Optional: Customize rate limiting (defaults are safe)
WEBHOOK_RATE_LIMIT_WINDOW=60000
WEBHOOK_MAX_REQUESTS_PER_WINDOW=30
WEBHOOK_REQUEST_DELAY=2000
